# Zoho API console (https://api-console.zoho.com) -> Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Filled in via `uv run scripts/get_refresh_token.py <grant-code>`
ZOHO_REFRESH_TOKEN=
# Data centre: com | eu | in | com.au | jp
ZOHO_DC=com
# Optional: skip the user.json lookup
ZOHO_ZSOID=

DOWNLOAD_DIR=data/recordings
# Case-insensitive regex matched against the recording topic
TITLE_PATTERN=pydata\s*26h
TIMEZONE=Africa/Nairobi
